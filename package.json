{
  "name": "chess-theory-rebuild",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0 --port 3040",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "pregenerate": "pnpm data",
    "prebuild": "pnpm data",
    "preview": "nuxt preview --host 0.0.0.0 --port 3040",
    "postinstall": "nuxt prepare",
    "data": "tsx scripts/build-openings.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "format": "prettier --write app tests scripts .storybook *.ts *.mjs *.json *.md .github",
    "format:check": "prettier --check app tests scripts .storybook *.ts *.mjs *.json *.md .github"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "nuxt": "4.4.6",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/vue3-vite": "9.1.20",
    "@types/node": "25.6.0",
    "@vite-pwa/nuxt": "1.1.1",
    "@vitejs/plugin-vue": "6.0.6",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "6.2.4",
    "happy-dom": "20.9.0",
    "prettier": "3.6.2",
    "storybook": "9.1.20",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.2",
    "vitest": "4.1.4",
    "vue-tsc": "3.3.12"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/kit": "4.4.6"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
